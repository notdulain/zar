<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and earlier. See https://developer.android.com/guide/topics/data/autobackup -->
<full-backup-content>
    <!-- Staged bank SMS stay on this phone: encrypted with a key that is never backed up. -->
    <exclude domain="database" path="capture_staging.db" />
    <exclude domain="database" path="capture_staging.db-wal" />
    <exclude domain="database" path="capture_staging.db-shm" />
    <!-- Who turned automatic capture on. A restored copy would show it on while the SMS receiver stays off. -->
    <exclude domain="file" path="datastore/auto_sms_capture.preferences_pb" />
    <!-- Whether amounts are hidden is a choice about this phone, not about the account. -->
    <exclude domain="sharedpref" path="amount_privacy.xml" />
</full-backup-content>
