rules_version = '2';

// ===============================================================
// Zar — Cloud Firestore Security Rules (prototype, review before launch)
// ===============================================================
//
// Assumed Data Model
// ------------------
// All data is private to one user and lives under users/{uid}/...
// Nothing is stored on users/{uid} itself. Instants are epoch milliseconds (int) because
// offline writes may sync long after they were made, so request.time checks would reject
// honest offline saves. Dates are calendar days as "yyyy-MM-dd" strings (Asia/Colombo).
//
// Money map:   { currency: string(2-10), kind: 'FIAT'|'CRYPTO', digits: int(0-18),
//                minor: int (FIAT) | quantity: decimal string (CRYPTO) }
// Conversion:  { status: 'SAME' } | { status: 'MISSING', target: Money }
//              | { status: 'CONVERTED', amount: Money, rate: { base, quote: Money,
//                  rate: decimal string, asOf: int, source: 'MANUAL'|'BANK_MESSAGE'|'PROVIDER' } }
//
// accounts/{accountId}            create, update (no delete: archive instead)
//   id (== doc id), name (1-80), type, currency {code, kind, digits} (immutable),
//   opening {status, amount?}, openingDate, archived (bool), updatedAt (int)
//
// transactions/{transactionId}    WRITE-ONCE: create only
//   id (== doc id), accountId, type, amount (positive Money), date, time? (HH:mm), conversion,
//   source, createdAt; spendingClass (EXPENSE only, required), categoryId?, merchant?,
//   note?, transferId (transfer legs only, required), refundOf (REFUND only, required)
//
// corrections/{correctionId}      WRITE-ONCE: create only
//   id (== doc id), transactionId, changes (non-empty map of corrected fields;
//   a null value means "cleared"), correctedAt, reason?
//
// voids/{transactionId}           WRITE-ONCE: create only (durable, terminal undo)
//   transactionId (== doc id), voidedAt, reason?
//
// evidenceLinks/{evidenceId}      WRITE-ONCE: create only (one evidence -> one transaction)
//   evidenceId (== doc id), transactionId, linkedAt
//
// expectedPayments/{id}           create, update (no delete: cancel instead; CANCELLED is final)
//   id (== doc id), direction 'IN'|'OUT', amount (positive Money), dueDate, title (1-120),
//   source {type, projectId?, milestoneId?, billId?, occurrenceDate?}, accountId?,
//   status 'OPEN'|'CANCELLED', createdAt (immutable)
//
// paymentMatches/{expectedPaymentId_transactionId}   create, delete (no update)
//   expectedPaymentId, transactionId, amount (positive Money), matchedAt
//
// projects/{projectId}            create, update (no delete: archive instead)
//   id (== doc id), name (1-80), client? (1-80), currency {code, kind, digits} (immutable),
//   status 'ACTIVE'|'ARCHIVED', createdAt (immutable). Milestones are expectedPayments
//   with source FREELANCE_MILESTONE pointing at the project.
//
// cryptoOpeningCosts/{accountId}  create, update, delete (optional; delete clears it)
//   accountId (== doc id), cost (positive FIAT Money in LKR), approximate (bool), updatedAt (int).
//   What a crypto wallet's opening coins cost, so profit or loss on them can be worked out.
//
// bills/{billId}                  create, update (no delete: stop instead)
//   id (== doc id), name (1-80), accountId, amount (positive Money), frequency
//   'WEEKLY'|'MONTHLY'|'YEARLY', firstDue (date), status 'ACTIVE'|'STOPPED', createdAt (immutable),
//   reminderDaysBefore? (0, 1, 3 or 7: the bill's one reminder),
//   cancellation? 'INTENDED'|'CONFIRMED', cancelledFrom (date, required with CONFIRMED only).
//   Due dates are expectedPayments with source BILL_OCCURRENCE; a bill never posts an expense.
//
// goals/{goalId}                  create, update (no delete in U04)
//   id (== doc id), name (1-80), target (positive Money), targetDate? (YYYY-MM-DD), allocations (max 10),
//   allocation {accountId, amount}; allocations reserve money but do not write ledger entries.
//
// drafts/{draftId}                create, update, delete (unconfirmed proposals)
//   id (== doc id), source, status, proposals (list of maps, max 5), createdAt (immutable)
//   Raw message text is never stored here; it stays in encrypted on-device staging.
//
// Why write-once: the app saves records with set() using a stable client-generated ID.
// A replayed save on an existing document is an update, which these rules deny, so retries
// and offline replays cannot overwrite corrections or revive an undone record.
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function data() {
      return request.resource.data;
    }

    function hasRequiredFields(fields) {
      return data().keys().hasAll(fields);
    }

    function hasOnlyAllowedFields(fields) {
      return data().keys().hasOnly(fields);
    }

    function areImmutableFieldsUnchanged(fields) {
      return !data().diff(resource.data).affectedKeys().hasAny(fields);
    }

    function isId(value) {
      return value is string && value.size() > 0 && value.size() <= 128;
    }

    function isShortString(value, maxLen) {
      return value is string && value.size() > 0 && value.size() <= maxLen;
    }

    function isOptionalString(map, field, maxLen) {
      return !(field in map) || isShortString(map[field], maxLen);
    }

    // Field may be absent, null (cleared) or a bounded string. Used by corrections.
    function isClearableString(map, field, maxLen) {
      return !(field in map) || map[field] == null || isShortString(map[field], maxLen);
    }

    function isMillis(value) {
      return value is int && value > 0;
    }

    function isDateString(value) {
      return value is string && value.matches('^\\d{4}-\\d{2}-\\d{2}$');
    }

    function isTimeString(value) {
      return value is string && value.matches('^([01]\\d|2[0-3]):[0-5]\\d$');
    }

    function isDecimalString(value) {
      return value is string && value.size() <= 50 && value.matches('^\\d{1,30}(\\.\\d{1,18})?$');
    }

    function isCurrencyCode(value) {
      return value is string && value.matches('^[A-Z0-9]{2,10}$');
    }

    // ===============================================================
    // Shared value validators
    // ===============================================================

    function isMoney(m) {
      return m is map
        && m.keys().hasAll(['currency', 'kind', 'digits'])
        && isCurrencyCode(m.currency)
        && m.digits is int && m.digits >= 0 && m.digits <= 18
        && (
          (m.kind == 'FIAT' && m.keys().hasOnly(['currency', 'kind', 'digits', 'minor']) && m.minor is int)
          || (m.kind == 'CRYPTO' && m.keys().hasOnly(['currency', 'kind', 'digits', 'quantity']) && isDecimalString(m.quantity))
        );
    }

    function isPositiveMoney(m) {
      return isMoney(m)
        && ((m.kind == 'FIAT' && m.minor > 0)
          || (m.kind == 'CRYPTO' && !m.quantity.matches('^0+(\\.0+)?$')));
    }

    function isRate(r) {
      return r is map
        && r.keys().hasOnly(['base', 'quote', 'rate', 'asOf', 'source'])
        && r.keys().hasAll(['base', 'quote', 'rate', 'asOf', 'source'])
        && isMoney(r.base) && isMoney(r.quote)
        && isDecimalString(r.rate)
        && isMillis(r.asOf)
        && r.source in ['MANUAL', 'BANK_MESSAGE', 'PROVIDER'];
    }

    function isConversion(c) {
      return c is map && (
        (c.keys().hasOnly(['status']) && c.status == 'SAME')
        || (c.keys().hasOnly(['status', 'target']) && c.status == 'MISSING' && isMoney(c.target))
        || (c.keys().hasOnly(['status', 'amount', 'rate']) && c.keys().hasAll(['amount', 'rate'])
            && c.status == 'CONVERTED' && isMoney(c.amount) && c.amount.kind == 'FIAT' && isRate(c.rate))
      );
    }

    function isSpendingClass(value) {
      return value in ['COMMITTED', 'DISCRETIONARY', 'UNKNOWN'];
    }

    // ===============================================================
    // Domain validators
    // ===============================================================

    function isValidAccount(accountId) {
      let d = data();
      return hasOnlyAllowedFields(['id', 'name', 'type', 'currency', 'opening', 'openingDate', 'archived', 'updatedAt'])
        && hasRequiredFields(['id', 'name', 'type', 'currency', 'opening', 'openingDate', 'archived', 'updatedAt'])
        && d.id == accountId
        && isShortString(d.name, 80)
        && d.type in ['BANK', 'CASH', 'FREELANCE', 'CRYPTO']
        && d.currency is map
        && d.currency.keys().hasOnly(['code', 'kind', 'digits'])
        && d.currency.keys().hasAll(['code', 'kind', 'digits'])
        && isCurrencyCode(d.currency.code)
        && d.currency.kind in ['FIAT', 'CRYPTO']
        && d.currency.digits is int && d.currency.digits >= 0 && d.currency.digits <= 18
        && d.opening is map
        && (
          (d.opening.keys().hasOnly(['status']) && d.opening.status == 'UNKNOWN')
          || (d.opening.keys().hasOnly(['status', 'amount']) && d.opening.status in ['KNOWN', 'APPROXIMATE']
              && isMoney(d.opening.amount) && d.opening.amount.currency == d.currency.code)
        )
        && isDateString(d.openingDate)
        && d.archived is bool
        && isMillis(d.updatedAt);
    }

    function isValidTransaction(transactionId) {
      let d = data();
      return hasOnlyAllowedFields(['id', 'accountId', 'type', 'amount', 'date', 'time', 'conversion', 'spendingClass',
          'categoryId', 'merchant', 'note', 'source', 'transferId', 'refundOf', 'appliedRuleId', 'appliedRuleVersion',
          'createdAt'])
        && hasRequiredFields(['id', 'accountId', 'type', 'amount', 'date', 'conversion', 'source', 'createdAt'])
        && d.id == transactionId
        && isId(d.accountId)
        && d.type in ['INCOME', 'EXPENSE', 'TRANSFER_IN', 'TRANSFER_OUT', 'REFUND', 'ADJUSTMENT_IN', 'ADJUSTMENT_OUT']
        && isPositiveMoney(d.amount)
        && isDateString(d.date)
        && (!('time' in d) || isTimeString(d.time))
        && isConversion(d.conversion)
        && d.source in ['MANUAL', 'SMS', 'SHARED_TEXT', 'QUICK_NOTE', 'CASH_CATCH_UP', 'RECONCILIATION']
        && isMillis(d.createdAt)
        // Spending class only and always on expenses.
        && ((d.type == 'EXPENSE') == ('spendingClass' in d))
        && (!('spendingClass' in d) || isSpendingClass(d.spendingClass))
        // Refunds always link to the original purchase.
        && ((d.type == 'REFUND') == ('refundOf' in d))
        && (!('refundOf' in d) || isId(d.refundOf))
        // Transfer legs always carry their transfer ID.
        && ((d.type in ['TRANSFER_IN', 'TRANSFER_OUT']) == ('transferId' in d))
        && (!('transferId' in d) || isId(d.transferId))
        && isOptionalString(d, 'categoryId', 64)
        && isOptionalString(d, 'merchant', 120)
        && isOptionalString(d, 'note', 500)
        // The category rule that filled in the category: both fields together, on expenses only.
        && (('appliedRuleId' in d) == ('appliedRuleVersion' in d))
        && (!('appliedRuleId' in d) || (d.type == 'EXPENSE' && isId(d.appliedRuleId)
          && d.appliedRuleVersion is int && d.appliedRuleVersion >= 1));
    }

    function isValidCorrection(correctionId) {
      let d = data();
      let c = d.changes;
      return hasOnlyAllowedFields(['id', 'transactionId', 'changes', 'correctedAt', 'reason'])
        && hasRequiredFields(['id', 'transactionId', 'changes', 'correctedAt'])
        && d.id == correctionId
        && isId(d.transactionId)
        && isMillis(d.correctedAt)
        && isOptionalString(d, 'reason', 300)
        && c is map
        && c.size() > 0
        && c.keys().hasOnly(['amount', 'conversion', 'date', 'time', 'spendingClass', 'categoryId', 'merchant', 'note'])
        && (!('amount' in c) || isPositiveMoney(c.amount))
        && (!('conversion' in c) || isConversion(c.conversion))
        && (!('date' in c) || isDateString(c.date))
        && (!('time' in c) || c.time == null || isTimeString(c.time))
        && (!('spendingClass' in c) || isSpendingClass(c.spendingClass))
        && isClearableString(c, 'categoryId', 64)
        && isClearableString(c, 'merchant', 120)
        && isClearableString(c, 'note', 500);
    }

    function isValidVoid(transactionId) {
      let d = data();
      return hasOnlyAllowedFields(['transactionId', 'voidedAt', 'reason'])
        && hasRequiredFields(['transactionId', 'voidedAt'])
        && d.transactionId == transactionId
        && isMillis(d.voidedAt)
        && isOptionalString(d, 'reason', 300);
    }

    function isValidEvidenceLink(evidenceId) {
      let d = data();
      return hasOnlyAllowedFields(['evidenceId', 'transactionId', 'linkedAt'])
        && hasRequiredFields(['evidenceId', 'transactionId', 'linkedAt'])
        && d.evidenceId == evidenceId
        && isId(d.transactionId)
        && isMillis(d.linkedAt);
    }

    function isExpectedSource(s) {
      return s is map
        && s.keys().hasOnly(['type', 'projectId', 'milestoneId', 'billId', 'occurrenceDate'])
        && (
          (s.type == 'FREELANCE_MILESTONE' && s.keys().hasOnly(['type', 'projectId', 'milestoneId'])
            && isId(s.projectId) && isId(s.milestoneId))
          || (s.type == 'BILL_OCCURRENCE' && s.keys().hasOnly(['type', 'billId', 'occurrenceDate'])
            && isId(s.billId) && isDateString(s.occurrenceDate))
          || (s.type in ['QUICK_NOTE', 'MANUAL'] && s.keys().hasOnly(['type']))
        );
    }

    function isValidExpectedPayment(expectedPaymentId) {
      let d = data();
      return hasOnlyAllowedFields(['id', 'direction', 'amount', 'dueDate', 'title', 'source', 'accountId', 'status', 'createdAt'])
        && hasRequiredFields(['id', 'direction', 'amount', 'dueDate', 'title', 'source', 'status', 'createdAt'])
        && d.id == expectedPaymentId
        && d.direction in ['IN', 'OUT']
        && isPositiveMoney(d.amount)
        && isDateString(d.dueDate)
        && isShortString(d.title, 120)
        && isExpectedSource(d.source)
        && (!('accountId' in d) || isId(d.accountId))
        && d.status in ['OPEN', 'CANCELLED']
        && isMillis(d.createdAt);
    }

    function isValidPaymentMatch(matchId) {
      let d = data();
      return hasOnlyAllowedFields(['expectedPaymentId', 'transactionId', 'amount', 'matchedAt'])
        && hasRequiredFields(['expectedPaymentId', 'transactionId', 'amount', 'matchedAt'])
        && isId(d.expectedPaymentId)
        && isId(d.transactionId)
        && matchId == d.expectedPaymentId + '_' + d.transactionId
        && isPositiveMoney(d.amount)
        && isMillis(d.matchedAt);
    }

    function isValidProject(projectId) {
      let d = data();
      return hasOnlyAllowedFields(['id', 'name', 'client', 'currency', 'status', 'createdAt'])
        && hasRequiredFields(['id', 'name', 'currency', 'status', 'createdAt'])
        && d.id == projectId
        && isShortString(d.name, 80)
        && isOptionalString(d, 'client', 80)
        && d.currency is map
        && d.currency.keys().hasOnly(['code', 'kind', 'digits'])
        && d.currency.keys().hasAll(['code', 'kind', 'digits'])
        && isCurrencyCode(d.currency.code)
        && d.currency.kind in ['FIAT', 'CRYPTO']
        && d.currency.digits is int && d.currency.digits >= 0 && d.currency.digits <= 18
        && d.status in ['ACTIVE', 'ARCHIVED']
        && isMillis(d.createdAt);
    }

    // Validate the target once, then reuse its currency metadata for each allocation.
    // Re-running the generic money validator ten times exceeds the rules expression budget.
    function isGoalAllocation(a, target) {
      let m = a.amount;
      return a.keys().hasOnly(['accountId', 'amount'])
        && isId(a.accountId)
        && (target.kind == 'FIAT'
          ? m.minor is int && m.minor > 0
            && m == {'currency': target.currency, 'kind': 'FIAT', 'digits': target.digits, 'minor': m.minor}
          : isDecimalString(m.quantity) && !m.quantity.matches('^0+(\\.0+)?$')
            && m == {'currency': target.currency, 'kind': 'CRYPTO', 'digits': target.digits, 'quantity': m.quantity});
    }

    function isValidGoal(goalId) {
      let d = data();
      let a = d.allocations;
      let count = a.size();
      let target = d.target;
      return hasOnlyAllowedFields(['id', 'name', 'target', 'targetDate', 'allocations', 'updatedAt'])
        && hasRequiredFields(['id', 'name', 'target', 'allocations', 'updatedAt'])
        && d.id == goalId
        && isShortString(d.name, 80)
        && isPositiveMoney(target)
        && (!('targetDate' in d) || isDateString(d.targetDate))
        && isMillis(d.updatedAt)
        && a is list && count <= 10
        && (count < 1 || isGoalAllocation(a[0], target))
        && (count < 2 || isGoalAllocation(a[1], target))
        && (count < 3 || isGoalAllocation(a[2], target))
        && (count < 4 || isGoalAllocation(a[3], target))
        && (count < 5 || isGoalAllocation(a[4], target))
        && (count < 6 || isGoalAllocation(a[5], target))
        && (count < 7 || isGoalAllocation(a[6], target))
        && (count < 8 || isGoalAllocation(a[7], target))
        && (count < 9 || isGoalAllocation(a[8], target))
        && (count < 10 || isGoalAllocation(a[9], target));
    }

    function isValidOpeningCost(accountId) {
      let d = data();
      return hasOnlyAllowedFields(['accountId', 'cost', 'approximate', 'updatedAt'])
        && hasRequiredFields(['accountId', 'cost', 'approximate', 'updatedAt'])
        && d.accountId == accountId
        && isPositiveMoney(d.cost)
        && d.cost.kind == 'FIAT'
        && d.cost.currency == 'LKR'
        && d.approximate is bool
        && isMillis(d.updatedAt);
    }

    function isValidBill(billId) {
      let d = data();
      return hasOnlyAllowedFields(['id', 'name', 'accountId', 'amount', 'frequency', 'firstDue', 'status', 'createdAt',
            'reminderDaysBefore', 'cancellation', 'cancelledFrom'])
        && hasRequiredFields(['id', 'name', 'accountId', 'amount', 'frequency', 'firstDue', 'status', 'createdAt'])
        && d.id == billId
        && isShortString(d.name, 80)
        && isId(d.accountId)
        && isPositiveMoney(d.amount)
        && d.frequency in ['WEEKLY', 'MONTHLY', 'YEARLY']
        && isDateString(d.firstDue)
        && d.status in ['ACTIVE', 'STOPPED']
        && isMillis(d.createdAt)
        && (!('reminderDaysBefore' in d) || d.reminderDaysBefore in [0, 1, 3, 7])
        && (!('cancellation' in d) || d.cancellation in ['INTENDED', 'CONFIRMED'])
        && (('cancellation' in d && d.cancellation == 'CONFIRMED') == ('cancelledFrom' in d))
        && (!('cancelledFrom' in d) || isDateString(d.cancelledFrom));
    }

    function isValidCategoryRule(ruleId) {
      let d = data();
      return hasOnlyAllowedFields(['id', 'merchantKey', 'displayName', 'categoryId', 'accountId', 'enabled', 'version',
          'createdAt', 'updatedAt'])
        && hasRequiredFields(['id', 'merchantKey', 'displayName', 'categoryId', 'enabled', 'version', 'createdAt', 'updatedAt'])
        && d.id == ruleId
        && isShortString(d.merchantKey, 120)
        && isShortString(d.displayName, 120)
        && isShortString(d.categoryId, 64)
        && isOptionalString(d, 'accountId', 128)
        && d.enabled is bool
        && d.version is int && d.version >= 1
        && isMillis(d.createdAt)
        && isMillis(d.updatedAt);
    }

    function isValidProposal(p) {
      return p is map
        && p.keys().hasOnly(['kind', 'type', 'direction', 'amount', 'sent', 'received', 'accountId', 'fromAccountId',
            'toAccountId', 'date', 'time', 'dueDate', 'title', 'spendingClass', 'categoryId', 'merchant', 'note', 'uncertainFields'])
        && p.kind in ['ACTUAL_TRANSACTION', 'EXPECTED', 'TRANSFER']
        && (!('amount' in p) || isMoney(p.amount))
        && (!('sent' in p) || isMoney(p.sent))
        && (!('received' in p) || isMoney(p.received))
        && isOptionalString(p, 'type', 32)
        && isOptionalString(p, 'direction', 8)
        && isOptionalString(p, 'accountId', 128)
        && isOptionalString(p, 'fromAccountId', 128)
        && isOptionalString(p, 'toAccountId', 128)
        && (!('date' in p) || isDateString(p.date))
        && (!('time' in p) || isTimeString(p.time))
        && (!('dueDate' in p) || isDateString(p.dueDate))
        && isOptionalString(p, 'title', 120)
        && isOptionalString(p, 'spendingClass', 32)
        && isOptionalString(p, 'categoryId', 64)
        && isOptionalString(p, 'merchant', 120)
        && isOptionalString(p, 'note', 500)
        && (!('uncertainFields' in p) || (p.uncertainFields is list && p.uncertainFields.size() <= 10));
    }

    function isValidDraft(draftId) {
      let d = data();
      let p = d.proposals;
      return hasOnlyAllowedFields(['id', 'source', 'status', 'proposals', 'createdAt'])
        && hasRequiredFields(['id', 'source', 'status', 'proposals', 'createdAt'])
        && d.id == draftId
        && d.source in ['QUICK_NOTE', 'SMS', 'SHARED_TEXT']
        && d.status in ['PENDING_REVIEW', 'CONFIRMED', 'DISCARDED']
        && isMillis(d.createdAt)
        && p is list && p.size() > 0 && p.size() <= 5
        && isValidProposal(p[0])
        && (p.size() < 2 || isValidProposal(p[1]))
        && (p.size() < 3 || isValidProposal(p[2]))
        && (p.size() < 4 || isValidProposal(p[3]))
        && (p.size() < 5 || isValidProposal(p[4]));
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      // No data is stored on the user document itself.
      allow read, write: if false;

      match /accounts/{accountId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidAccount(accountId);
        // Currency is fixed once history exists; archive instead of deleting.
        allow update: if isOwner(userId) && isValidAccount(accountId)
          && areImmutableFieldsUnchanged(['id', 'currency']);
        allow delete: if false;
      }

      match /transactions/{transactionId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidTransaction(transactionId);
        allow update, delete: if false;
      }

      match /corrections/{correctionId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidCorrection(correctionId);
        allow update, delete: if false;
      }

      match /voids/{transactionId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidVoid(transactionId);
        allow update, delete: if false;
      }

      match /evidenceLinks/{evidenceId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidEvidenceLink(evidenceId);
        allow update, delete: if false;
      }

      match /expectedPayments/{expectedPaymentId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidExpectedPayment(expectedPaymentId)
          && data().status == 'OPEN';
        // Cancelled expectations stay cancelled so history and stopped schedules are honest.
        allow update: if isOwner(userId) && isValidExpectedPayment(expectedPaymentId)
          && areImmutableFieldsUnchanged(['id', 'direction', 'createdAt'])
          && (resource.data.status == 'OPEN' || data().status == 'CANCELLED');
        allow delete: if false;
      }

      match /paymentMatches/{matchId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidPaymentMatch(matchId);
        allow delete: if isOwner(userId);
        allow update: if false;
      }

      match /projects/{projectId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidProject(projectId);
        // Milestones are in the project's currency, so it never changes; archive instead of deleting.
        allow update: if isOwner(userId) && isValidProject(projectId)
          && areImmutableFieldsUnchanged(['id', 'currency', 'createdAt']);
        allow delete: if false;
      }

      match /goals/{goalId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidGoal(goalId);
        allow update: if isOwner(userId) && isValidGoal(goalId)
          && areImmutableFieldsUnchanged(['id']);
        allow delete: if false;
      }

      match /cryptoOpeningCosts/{accountId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidOpeningCost(accountId);
        // Clearing an optional opening cost removes it.
        allow delete: if isOwner(userId);
      }

      match /bills/{billId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidBill(billId);
        allow update: if isOwner(userId) && isValidBill(billId) && areImmutableFieldsUnchanged(['id', 'createdAt']);
        // Stopped bills keep their history.
        allow delete: if false;
      }

      // A rule keeps its name and start date; every edit raises the version. Rules are switched off, never deleted.
      match /categoryRules/{ruleId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidCategoryRule(ruleId) && data().version == 1;
        allow update: if isOwner(userId) && isValidCategoryRule(ruleId)
          && areImmutableFieldsUnchanged(['id', 'merchantKey', 'displayName', 'createdAt'])
          && data().version > resource.data.version;
        allow delete: if false;
      }

      match /drafts/{draftId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidDraft(draftId) && data().status == 'PENDING_REVIEW';
        // Only pending drafts change; confirmed or discarded drafts are final.
        allow update: if isOwner(userId) && resource.data.status == 'PENDING_REVIEW'
          && (
            // A status-only close reuses the already validated proposals. Revalidating them
            // alongside the new ledger record can exceed an atomic request's expression budget.
            (data().diff(resource.data).affectedKeys().hasOnly(['status'])
              && data().status in ['PENDING_REVIEW', 'CONFIRMED', 'DISCARDED'])
            || (isValidDraft(draftId) && areImmutableFieldsUnchanged(['id', 'source', 'createdAt']))
          );
        allow delete: if isOwner(userId);
      }
    }
  }
}
