<?xml version="1.0" encoding="utf-8"?>
<!-- See https://developer.android.com/about/versions/12/backup-restore#xml-changes -->
<data-extraction-rules>
    <cloud-backup>
        <!-- Staged bank SMS stay on this phone: encrypted with a key that is never backed up. -->
        <exclude domain="database" path="capture_staging.db" />
        <exclude domain="database" path="capture_staging.db-wal" />
        <exclude domain="database" path="capture_staging.db-shm" />
    </cloud-backup>
    <device-transfer>
        <!-- Staged bank SMS stay on this phone: encrypted with a key that is never backed up. -->
        <exclude domain="database" path="capture_staging.db" />
        <exclude domain="database" path="capture_staging.db-wal" />
        <exclude domain="database" path="capture_staging.db-shm" />
    </device-transfer>
</data-extraction-rules>
