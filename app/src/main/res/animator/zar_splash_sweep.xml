<set xmlns:android="http://schemas.android.com/apk/res/android">
    <objectAnimator android:propertyName="translateX" android:valueFrom="-20" android:valueTo="45"
        android:valueType="floatType" android:duration="1400" android:repeatCount="0"
        android:interpolator="@android:interpolator/fast_out_slow_in" />
    <objectAnimator android:propertyName="scaleX" android:valueType="floatType" android:duration="1400"
        android:repeatCount="0" android:interpolator="@android:interpolator/linear">
        <propertyValuesHolder android:propertyName="scaleX" android:valueType="floatType">
            <keyframe android:fraction="0" android:value="0.1" />
            <keyframe android:fraction="0.5" android:value="0.65" />
            <keyframe android:fraction="1" android:value="0.1" />
        </propertyValuesHolder>
    </objectAnimator>
</set>
